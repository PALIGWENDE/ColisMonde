# Base de données
DATABASE_URL="postgresql://colismonde:colismonde@localhost:5432/colismonde?schema=public"

# Serveur
PORT=4000
NODE_ENV=development

# URL du frontend autorisée par CORS (liste séparée par des virgules)
WEB_ORIGIN=http://localhost:3000

# JWT — générez des secrets forts en production (ex: openssl rand -base64 48)
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_32chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_32chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Cookies
COOKIE_SECURE=false

# Upload de fichiers
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Bcrypt
BCRYPT_SALT_ROUNDS=12
