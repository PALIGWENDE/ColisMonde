generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Utilisateurs & authentification
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  phone        String?
  firstName    String
  lastName     String
  avatarUrl    String?
  bio          String?
  country      String?
  city         String?
  isVerified   Boolean @default(false)
  isAdmin      Boolean @default(false)
  isSuspended  Boolean @default(false)

  // Suppression de compte = anonymisation (pas de hard delete, cf. historique des transactions
  // référencé par Booking/Review/Message/Report). Non-null => compte fermé, connexion impossible.
  deletedAt DateTime?

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  createdAt DateTime @updatedAt @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens         RefreshToken[]
  verificationDocuments VerificationDocument[]
  deviceTokens          DeviceToken[]

  trips            Trip[]
  packageRequests  PackageRequest[]
  bookingsAsSender   Booking[] @relation("BookingSender")
  bookingsAsTraveler Booking[] @relation("BookingTraveler")

  messagesSent  Message[]
  reviewsWritten Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")

  reportsFiled   Report[] @relation("ReportReporter")
  reportsAgainst Report[] @relation("ReportTarget")

  notifications Notification[]

  blocksMade     Block[] @relation("BlockBlocker")
  blocksReceived Block[] @relation("BlockBlocked")

  @@index([email])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenHash String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Jetons Expo Push enregistrés par l'app mobile pour les notifications hors-ligne (app fermée) —
// le web n'utilise pas ce modèle (il reçoit ses notifications en direct via Socket.IO uniquement).
model DeviceToken {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoPushToken String   @unique
  platform      String
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @updatedAt

  @@index([userId])
}

enum DocumentType {
  ID_CARD
  PASSPORT
  DRIVER_LICENSE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationDocument {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      DocumentType
  fileUrl   String
  status    DocumentStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt DateTime       @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Référentiel des villes (autocomplete + arcs du globe 3D)
// ---------------------------------------------------------------------------

model City {
  id          String @id @default(uuid())
  name        String
  country     String
  countryCode String
  lat         Float
  lng         Float
  population  Int?

  tripsAsDeparture   Trip[]            @relation("TripDeparture")
  tripsAsArrival     Trip[]            @relation("TripArrival")
  requestsAsDeparture PackageRequest[] @relation("RequestDeparture")
  requestsAsArrival   PackageRequest[] @relation("RequestArrival")

  @@unique([name, countryCode])
  @@index([name])
  @@index([countryCode])
}

// ---------------------------------------------------------------------------
// Trajets (voyageurs) & demandes d'envoi (expéditeurs)
// ---------------------------------------------------------------------------

enum TransportMode {
  PLANE
  TRAIN
  CAR
  BUS
  BOAT
  OTHER
}

enum PackageCategory {
  DOCUMENTS
  ELECTRONICS
  CLOTHING
  FOOD
  COSMETICS
  BOOKS
  OTHER
}

enum ItemSize {
  SMALL
  MEDIUM
  LARGE
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Trip {
  id     String @id @default(uuid())
  travelerId String
  traveler   User   @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  departureCityId String
  departureCity   City   @relation("TripDeparture", fields: [departureCityId], references: [id])
  arrivalCityId   String
  arrivalCity     City   @relation("TripArrival", fields: [arrivalCityId], references: [id])

  departureDate DateTime
  arrivalDate   DateTime?

  availableWeightKg  Float
  pricePerKg         Float
  acceptedCategories PackageCategory[]
  maxItemSize        ItemSize
  transportMode      TransportMode
  notes              String?

  status    TripStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  bookings Booking[]

  @@index([travelerId])
  @@index([departureCityId, arrivalCityId])
  @@index([departureDate])
}

enum RequestStatus {
  OPEN
  MATCHED
  CANCELLED
}

model PackageRequest {
  id       String @id @default(uuid())
  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  departureCityId String
  departureCity   City   @relation("RequestDeparture", fields: [departureCityId], references: [id])
  arrivalCityId   String
  arrivalCity     City   @relation("RequestArrival", fields: [arrivalCityId], references: [id])

  desiredDate  DateTime
  weightKg     Float
  category     PackageCategory
  description  String
  sizeEstimate ItemSize
  isUrgent     Boolean         @default(false)
  offeredPrice Float

  status    RequestStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  bookings Booking[]

  @@index([senderId])
  @@index([departureCityId, arrivalCityId])
  @@index([desiredDate])
}

// ---------------------------------------------------------------------------
// Booking = mise en relation confirmée entre un Trip et une PackageRequest
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  DISPUTED
}

enum InsuranceTier {
  BASIC
  PREMIUM
}

model Booking {
  id String @id @default(uuid())

  tripId    String
  trip      Trip           @relation(fields: [tripId], references: [id])
  requestId String
  request   PackageRequest @relation(fields: [requestId], references: [id])

  senderId   String
  sender     User   @relation("BookingSender", fields: [senderId], references: [id])
  travelerId String
  traveler   User   @relation("BookingTraveler", fields: [travelerId], references: [id])

  // Qui a initié la proposition (sender en réservant un trajet, ou traveler en répondant à une demande) :
  // détermine qui doit accepter/refuser côté contrepartie.
  initiatorId      String
  status           BookingStatus @default(PENDING)
  agreedPrice      Float
  insuranceTier    InsuranceTier @default(BASIC)
  insuranceFee     Float         @default(0)
  serviceFee       Float         @default(0)

  // Code à 6 chiffres présenté au voyageur à la remise finale (cf. écran "Suivi de livraison")
  confirmationCode String?
  confirmedAt      DateTime?
  proofPhotoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackingEvents TrackingEvent[]
  conversation   Conversation?
  payment        Payment?
  reviews        Review[]
  reports        Report[]

  @@index([senderId])
  @@index([travelerId])
  @@index([tripId])
  @@index([requestId])
}

model TrackingEvent {
  id          String        @id @default(uuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status      BookingStatus
  label       String
  description String?
  location    String?
  occurredAt  DateTime      @default(now())

  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Messagerie
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Avis, signalements, paiements, notifications
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([bookingId, authorId])
  @@index([targetId])
}

enum ReportReason {
  FRAUD
  INAPPROPRIATE_BEHAVIOR
  ITEM_MISMATCH
  NO_SHOW
  SAFETY_CONCERN
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  reporter     User         @relation("ReportReporter", fields: [reporterId], references: [id])
  targetUserId String?
  targetUser   User?        @relation("ReportTarget", fields: [targetUserId], references: [id])
  bookingId    String?
  booking      Booking?     @relation(fields: [bookingId], references: [id])
  reason       ReportReason
  description  String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  @@index([reporterId])
  @@index([targetUserId])
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount        Float
  shippingFee   Float
  serviceFee    Float
  insuranceFee  Float
  currency      String        @default("EUR")
  status        PaymentStatus @default(PENDING)
  provider      String        @default("mock")
  providerRef   String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  MESSAGE_RECEIVED
  PACKAGE_PICKED_UP
  PACKAGE_IN_TRANSIT
  PACKAGE_DELIVERED
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  DOCUMENT_REVIEWED
}

model Notification {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  body            String
  isRead          Boolean          @default(false)
  relatedBookingId String?
  createdAt       DateTime         @default(now())

  @@index([userId, isRead])
}
